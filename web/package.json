{
  "name": "canharbor-web",
  "version": "0.1.0-dev",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun --bun run vite build",
    "test:e2e": "bun --bun run playwright test",
    "format": "prettier --write src tests *.ts index.html ../scripts/*.mjs",
    "format:check": "prettier --check src tests *.ts index.html ../scripts/*.mjs",
    "api:generate": "bun ../scripts/generate-api.mjs",
    "api:check": "bun ../scripts/generate-api.mjs --check",
    "i18n:check": "bun ../scripts/check-i18n.mjs && bun ../scripts/test-i18n.mjs"
  },
  "dependencies": {
    "i18next": "^27.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "prettier": "^3.6.0",
    "json-schema-to-typescript": "^15.0.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2"
  },
  "packageManager": "bun@1.4.2"
}
